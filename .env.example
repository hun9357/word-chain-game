# No API keys required for MVP - Dictionary API is public
# Add Google AdSense ID when ready
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxx

# Public site origin used to build shareable challenge links (/c/<code>).
# Falls back to https://dailywordchain.com if unset. Set this in Vercel env vars.
NEXT_PUBLIC_SITE_URL=https://dailywordchain.com
